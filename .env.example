# VeloCloud API Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# VCO Hostname or IP Address (without https://)
# Examples: vco123.velocloud.net or 192.168.1.100
VCO_HOSTNAME=vcoXXX.velocloud.net

# API Token (automatically includes "Token " prefix when using setup_config.py)
# Get this from the VCO UI or by running createToken.py with session credentials
# When manually editing this file, include the "Token " prefix as shown below
VCO_TOKEN=Token your-api-token-here

# Default Enterprise ID (numeric, optional - can be provided per script)
VCO_ENTERPRISE_ID=123

# Enterprise Logical ID (UUID format, optional - needed for API v2 calls)
VCO_ENTERPRISE_LOGICAL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Edge ID (numeric, optional - default edge for testing)
VCO_EDGE_ID=5064

# SSL Certificate Verification (true or false)
# Set to false for development/testing with self-signed certificates
VCO_VERIFY_SSL=false
